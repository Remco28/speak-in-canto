# Canto Reader — home server systemd unit example.
#
# Install to /etc/systemd/system/canto-reader.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now canto-reader
#
# Adjust User, WorkingDirectory, EnvironmentFile, and the listen address/port
# to match your setup. See docs/DEPLOY_HOME_SERVER.md.

[Unit]
Description=Canto Reader (Flask + waitress)
After=network.target

[Service]
Type=simple
User=canto
WorkingDirectory=/opt/canto-reader
EnvironmentFile=/opt/canto-reader/.env
ExecStart=/opt/canto-reader/.venv/bin/python -m waitress --host=0.0.0.0 --port=8734 --threads=4 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
