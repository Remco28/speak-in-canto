[Unit]
Description=Canto Reader
Documentation=file:///home/frank/Projects/speak-in-canto/README.md
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=frank
Group=frank
WorkingDirectory=/home/frank/Projects/speak-in-canto
EnvironmentFile=-/home/frank/Projects/speak-in-canto/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/frank/Projects/speak-in-canto/.venv/bin/python -m waitress --host=127.0.0.1 --port=8927 --threads=4 app:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
